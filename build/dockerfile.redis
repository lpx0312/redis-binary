FROM debian:bookworm-slim AS builder

ARG TARGETARCH
ARG REDIS_VERSION=7.4.1
ARG DIR=redis-${REDIS_VERSION}-linux-${TARGETARCH}
ARG BUILD_TOOLS="build-essential ca-certificates curl libssl-dev"

RUN apt-get update && apt-get install -y --no-install-recommends $BUILD_TOOLS \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

RUN curl -fsSLo redis.tar.gz https://download.redis.io/releases/redis-${REDIS_VERSION}.tar.gz \
    && tar xzf redis.tar.gz

WORKDIR /build/redis-${REDIS_VERSION}

RUN make -j"$(nproc)" BUILD_TLS=yes \
    && mkdir -p /package/${DIR}/bin \
    && for bin in redis-server redis-cli redis-benchmark redis-sentinel redis-check-aof redis-check-rdb; do \
        if [ ! -f src/${bin} ] && [ "${bin}" = "redis-sentinel" ]; then \
            cp src/redis-server src/${bin}; \
        fi; \
        strip src/${bin}; \
        cp src/${bin} /package/${DIR}/bin/; \
    done \
    && cd /package \
    && tar czf redis-${REDIS_VERSION}-linux-${TARGETARCH}.tar.gz ${DIR}

FROM scratch
COPY --from=builder /package/*.tar.gz /
