
# Redis 编译基础镜像 —— glibc 2.28 基线(Rocky Linux 8)
# 构建示例:
#   docker build -f base/Dockerfile-glib2.28 --build-arg TARGETARCH=amd64 -t redis-binary:base-glib-2.28 .
#   # 国内构建用南大镜像加速:
#   docker build -f base/Dockerfile-glib2.28 --build-arg TARGETARCH=amd64 --build-arg ZONE=cn -t redis-binary:base-glib-2.28 .
#   # 内网走代理下载 patchelf:
#   docker build -f base/Dockerfile-glib2.28 --build-arg TARGETARCH=amd64 --build-arg GH_PROXY=https://gh.1102345.xyz/ -t redis-binary:base-glib-2.28 .
#
# 可用 ARG:
#   ZONE             区域:空(默认)=官方源;cn=南大镜像(国内加速)
#   GH_PROXY         GitHub 下载代理前缀,默认空(直连)。例:https://gh.1102345.xyz/
#   PATCHELF_VERSION patchelf 版本,默认 0.19.1
#   TARGETARCH       目标架构(amd64/arm64),CI 显式传入
FROM rockylinux:8.9

ARG ZONE=""
ARG GH_PROXY=""
ARG PATCHELF_VERSION=0.19.1
ARG TARGETARCH

# ZONE=cn 时把 Rocky 官方源替换为南大镜像(禁 mirrorlist,改 baseurl)
RUN if [ "${ZONE}" = "cn" ]; then \
        echo "==> [ZONE=cn] Rocky 源 -> 南大镜像"; \
        sed -i \
            -e 's|^mirrorlist=|#mirrorlist=|g' \
            -e 's|^#baseurl=http://dl.rockylinux.org/$contentdir|baseurl=https://mirror.nju.edu.cn/rocky|g' \
            /etc/yum.repos.d/Rocky-*.repo; \
    else \
        echo "==> [ZONE=默认] 使用 Rocky 官方源"; \
    fi

# 安装编译依赖:
#   - gcc-toolset-12(GCC 12):Rocky 8 默认 gcc 8.5 也能编 Redis,但保持与
#     xtrabackup-binary 一致的新工具链习惯,生成的二进制兼容性更好排查
#   - openssl-devel:Rocky 8 自带 OpenSSL 1.1.1,满足 Redis 7.x BUILD_TLS=yes
RUN yum install -y ca-certificates curl tar make zlib-devel \
        openssl-devel \
        gcc-toolset-12-gcc \
        gcc-toolset-12-gcc-c++ \
        gcc-toolset-12-binutils && \
    yum clean all && \
    rm -rf /var/cache/yum

# 安装新版 patchelf(用于给 redis 二进制设置 RPATH)
# 架构映射:docker 用 amd64/arm64,patchelf 包名用 x86_64/aarch64
RUN set -e && \
    case "$TARGETARCH" in \
        amd64)  PE_ARCH=x86_64  ;; \
        arm64)  PE_ARCH=aarch64 ;; \
        *)      PE_ARCH="$TARGETARCH" ;; \
    esac && \
    PE_URL="${GH_PROXY}https://github.com/NixOS/patchelf/releases/download/${PATCHELF_VERSION}/patchelf-${PATCHELF_VERSION}-${PE_ARCH}.tar.gz" && \
    echo "==> 下载 patchelf: $PE_URL" && \
    curl -sSL -o /tmp/patchelf.tar.gz "$PE_URL" && \
    tar -xzf /tmp/patchelf.tar.gz -C /tmp && \
    cp /tmp/bin/patchelf /usr/local/bin/patchelf && \
    chmod +x /usr/local/bin/patchelf && \
    rm -rf /tmp/patchelf* && \
    patchelf --version

# 全局启用 gcc-toolset-12(编译脚本里统一 source)
RUN echo "source /opt/rh/gcc-toolset-12/enable" > /etc/profile.d/gcc-toolset.sh

# 打印基线信息(glibc 版本 + OpenSSL 版本)
RUN ldd --version | head -1 && \
    echo "OpenSSL: $(openssl version)"
